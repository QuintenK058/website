# Productiedomein (zonder slash aan het eind)
NEXT_PUBLIC_SITE_URL=https://www.qkcommerce.nl

# --- Formulieren (/api/lead) ---
# Optie 1 (aanbevolen): Resend. Verifieer je domein in Resend.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=QK Website <website@qkcommerce.nl>
# Optie 2 (terugval): Formspree-endpoint, bijv. https://formspree.io/f/abcdwxyz
FORMSPREE_ENDPOINT=
# Optioneel: Upstash Redis voor rate-limiting over alle serverinstanties
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (optioneel) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=

# true = toon TODO-markeringen, drafts en niet-goedgekeurde cases (preview-deploy)
NEXT_PUBLIC_PREVIEW=
